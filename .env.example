# =====================================================================
# PUNE CIVIC PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit real credentials.
# =====================================================================

# 1. DATABASE CONFIGURATION
# MongoDB Atlas connection string (or local MongoDB during dev)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.pune.mongodb.net/pune_civic?retryWrites=true&w=majority

# 2. AUTHENTICATION & SECURITY
# Cryptographic secret for signing session JWTs (minimum 32 characters in production)
JWT_SECRET=replace_with_strong_random_secret_minimum_32_characters_for_production
# Pre-shared bearer token for securing automated Vercel Cron jobs / cron escalation
CRON_SECRET=replace_with_strong_random_cron_bearer_token

# 3. PLATFORM GENERAL SETTINGS
NEXT_PUBLIC_APP_URL=https://punecivic.org
NODE_ENV=production

# 4. INITIAL SUPER ADMIN BOOTSTRAP (Used only during initialization)
SUPERADMIN_INITIAL_EMAIL=admin@punecivic.org
SUPERADMIN_INITIAL_PASSWORD=ReplaceWithStrongPassword2026!
SUPERADMIN_INITIAL_PHONE=9876543210
SUPERADMIN_INITIAL_NAME=System Super Administrator

# 5. OPTIONAL AI-ASSISTED COMPLAINT INTELLIGENCE (Google Gemini 1.5 Flash)
# If omitted, platform seamlessly falls back to local high-accuracy bilingual Pune NLP engine
GEMINI_API_KEY=your_gemini_api_key_here

# 6. PRODUCTION OBJECT STORAGE (Cloudinary or AWS S3)
# If omitted, platform saves uploaded evidence to local public/uploads directory
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AWS S3 Alternative (Optional)
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET_NAME=pune-civic-evidence-storage
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# 7. MULTI-CHANNEL CITIZEN NOTIFICATIONS
# SMTP Email Configuration
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password_or_api_key
SMTP_FROM_EMAIL=alerts@punecivic.org
SMTP_FROM_NAME=Pune Civic Platform Alerts

# SMS Gateway (Fast2SMS / MSG91 / Twilio)
SMS_PROVIDER=FAST2SMS
SMS_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=PUNECV

# WhatsApp Business / Meta Cloud API (Optional)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
